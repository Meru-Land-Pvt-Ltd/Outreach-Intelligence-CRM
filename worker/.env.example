# Worker environment example. Copy to .env.production and fill secrets.
# Only behavior-relevant variables are documented here — never commit real keys.

MONGODB_URI=mongodb://127.0.0.1:27017/outreach_intelligence_crm
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Manual-mode workflow flags -------------------------------------------
# The required workflow is manual: crawl -> Brand Map -> marketing selects
# brands -> Find Emails -> manual push to Enoylity/MHD.
# Both automatic pipeline stages are DISABLED by default.
AUTO_EMAIL_DISCOVERY_ENABLED=false
AUTO_INSTANTLY_EXPORT_ENABLED=false

# Max contacts stored/selected for outreach per brand (best-ranked first).
MAX_EMAILS_PER_BRAND=4

# When the automatic discovery stage is enabled, it still processes only
# brands manually selected in Brand Map (default true). Set to false only to
# restore the legacy process-everything behavior.
EMAIL_DISCOVERY_SELECTED_ONLY=true

# Escape hatch: allow paid providers (Hunter/Apollo/Prospeo) for brands that
# are NOT selected. Default false — paid credits only for selected brands or
# explicit manual jobs.
EMAIL_DISCOVERY_ALLOW_UNSELECTED_PROVIDERS=false

# --- Crawl limits -----------------------------------------------------------
# Per-seed brand limit is stored on the SeedBrand (crawlLimit) and set from
# the Control Panel. This factor converts the brand limit into a raw-video
# crawl ceiling (limit x factor, min 200).
CRAWL_VIDEOS_PER_BRAND_FACTOR=30

# --- Brand quality filtering ------------------------------------------------
# 0 = score every brand but filter nothing (default). Set e.g. 30 to skip
# creating Brand Map rows below that quality score (audited in the
# pipeline tracker).
BRANDMAP_MIN_QUALITY_SCORE=0

# Brands with a KNOWN PGA below this are never auto-exported to Instantly.
AUTO_EXPORT_MIN_PGA=80

# --- Provider filters (paid credit hygiene) ---------------------------------
# HUNTER_DEPARTMENTS=marketing,sales,management,communication,executive,operations
# APOLLO_PERSON_TITLES=Marketing Manager,Influencer Marketing Manager,...
# PROSPEO_SEARCH_PAGES=3

# Provider API keys (required for paid discovery; never commit real values)
# OPENAI_API_KEY=
# YOUTUBE_API_KEYS=
# HUNTER_API_KEY=
# APOLLO_API_KEY=
# PROSPEO_API_KEY=
# MILLION_VERIFIER_API_KEY=
# INSTANTLY_API_KEY=
