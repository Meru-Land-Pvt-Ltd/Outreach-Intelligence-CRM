# Backend environment example. Copy to .env.production and fill secrets.
# Only behavior-relevant variables are documented here — never commit real keys.

MONGODB_URI=mongodb://127.0.0.1:27017/outreach_intelligence_crm
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
PORT=5000

# --- Outreach caps -----------------------------------------------------------
# Max contacts exported/pushed per brand per channel (best-ranked first).
MAX_EMAILS_PER_BRAND=4

# --- Instantly export job --------------------------------------------------
# Background export job timeout and in-memory retention.
INSTANTLY_EXPORT_JOB_TIMEOUT_MS=1800000
INSTANTLY_EXPORT_JOB_RETENTION_MS=21600000

# --- PGA scoring weights (must be >= 0; renormalized over known factors) ----
PGA_WEIGHT_PREVIOUS_COLLAB=35
PGA_WEIGHT_PRODUCT_LAUNCH=25
PGA_WEIGHT_PROMO_ACTIVITY=25
PGA_WEIGHT_US_AVAILABILITY=15

# Secrets (never commit real values)
# INSTANTLY_API_KEY=
# MILLION_VERIFIER_API_KEY=
# OPENAI_API_KEY=
# INSTANTLY_ENOYLITY_SENDERS=
# INSTANTLY_MHD_SENDERS=
